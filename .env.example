# NOTE: copier ce fichier en .env.local (ignoré par git) puis relancer `npm run dev`.

# NOTE: clé de l'API Groq, utilisée par le provider STT Groq Whisper, l'analyse IA des transcriptions et la réponse IA de la page Écho.
# Création gratuite sur https://console.groq.com/keys ; sans clé, Groq apparaît indisponible et les autres moteurs fonctionnent.
GROQ_API_KEY=

# NOTE: facultatif, modèles Groq de l'analyse IA et de la réponse IA (par défaut openai/gpt-oss-20b pour les deux).
# GROQ_ANALYSIS_MODEL=
# GROQ_REPLY_MODEL=
